{
  "name": "fb-crawler",
  "version": "1.3.29",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "xvibe.me.social-cluster",
    "productName": "Social Cluster X-Vibe",
    "artifactName": "${productName}-v${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "quanglv96",
        "repo": "social-cluster-xvibe"
      }
    ],
    "files": [
      "src/**/*",
      "!src/config/config.runtime.json",
      "package.json"
    ],
    "extraMetadata": {
      "config": {
        "rootUrl": "https://xvibe.me",
        "host": "https://xvibe.me",
        "headless": true,
        "maxImages": 100,
        "defaultWait": 3000
      }
    },
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "differentialPackage": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.13.5",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "localtunnel": "^2.0.2",
    "ngrok": "^5.0.0-beta.2",
    "playwright": "^1.58.2",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "description": "",
  "main": "src/main.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
